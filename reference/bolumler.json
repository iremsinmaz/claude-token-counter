{
  "_aciklama": [
    "Sistem promptunun bölümlerini gruplara ayırır. scripts/taban-hesapla.mjs bu dosyayı okur.",
    "Birim: her '# başlık'. 'parcala' listesindeki üst başlıklar '## başlık' düzeyinde bölünür.",
    "Kurallar sırayla denenir; birim adına uyan ilk kuralın grubu kullanılır, uymayan 'varsayilan' gruba gider.",
    "bayrak: claude.ai /api/account ayarlarındaki (ve sohbet ayarlarındaki) anahtar. true ise grup sayılır.",
    "Bayrak adları lugia19/Claude-Usage-Extension'dan alındı; bölüm-bayrak eşlemesi başlıklara göre tahmindir.",
    "tur 'baglayici': hesaba bağlı bağlayıcı araçları; taban tahmine eklenmez, ayrıca gösterilir."
  ],
  "parcala": ["Tools"],
  "varsayilan": "cekirdek",
  "gruplar": {
    "cekirdek": { "etiket": "Çekirdek" },
    "bellek": { "etiket": "Memory", "bayrak": "enabled_saffron" },
    "gecmis_sohbetler": { "etiket": "Geçmiş sohbet araması", "bayrak": "enabled_saffron_search" },
    "web_arama": { "etiket": "Web araması", "bayrak": "enabled_web_search" },
    "kod_dosya": { "etiket": "Kod çalıştırma ve dosya oluşturma", "bayrak": "enabled_monkeys_in_a_barrel" },
    "artifacts": { "etiket": "Artifacts", "bayrak": "preview_feature_uses_artifacts" },
    "ai_artifacts": { "etiket": "AI destekli artifacts", "bayrak": "enabled_turmeric" },
    "arastirma": { "etiket": "Research", "bayrak": "enabled_compass" },
    "baglayicilar": { "etiket": "Bağlayıcılar (Gmail, Takvim, Drive, Docs)", "tur": "baglayici" }
  },
  "kurallar": [
    { "desen": "^mcp__(Gmail|Google_Calendar|Google_Drive|Claude_Docs)__", "grup": "baglayicilar" },
    { "desen": "^(memory_|forbidden_memory_phrases$|appropriate_boundaries_re_memory$)", "grup": "bellek" },
    { "desen": "^(past_chats_tools|conversation_search|recent_chats|read_conversation)$", "grup": "gecmis_sohbetler" },
    { "desen": "^(search_instructions|web_fetch|web_search|web_search_fast|image_search)$", "grup": "web_arama" },
    { "desen": "^(computer_use|available_skills|network_configuration|filesystem_configuration|bash_tool|create_file|str_replace|view|present_files|search_skills|suggest_skills)$", "grup": "kod_dosya" },
    { "desen": "^(publishing_artifacts|persistent_storage_for_artifacts|Artifact)$", "grup": "artifacts" },
    { "desen": "^anthropic_api_in_artifacts$", "grup": "ai_artifacts" },
    { "desen": "^suggest_research$", "grup": "arastirma" }
  ]
}
