{
  "manifest_version": 3,
  "name": "Claude Token Sayacı",
  "version": "1.0.0",
  "description": "claude.ai sohbetlerinde kullanılan tahmini token sayısını canlı gösterir.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png",
    "512": "icons/icon-512.png"
  },
  "content_scripts": [
    {
      "matches": ["https://claude.ai/*"],
      "js": ["baseline.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
